# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────
# SQLite (local dev, no install needed):
DATABASE_URL=sqlite+aiosqlite:///./gwr_dev.db

# PostgreSQL (production / pgvector):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/gwr

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AWS S3 (leave blank to use local filesystem storage) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=gwr-evidence

# ── Email ────────────────────────────────────────────────────────────
# Preferred: Brevo HTTP API (no SMTP needed, free 300 emails/day).
# Create an API key at https://app.brevo.com/settings/keys/api and paste below.
# When BREVO_API_KEY is set, it takes precedence over SMTP / SendGrid.
BREVO_API_KEY=

# Fallback: generic SMTP — works with any free provider and accepts ANY
# recipient domain (Gmail, Yahoo, custom domains, …).
#
# ▶ Gmail (free, ~500 emails/day) — needs an App Password:
#     https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx     # 16-char app password (no quotes)
#   SMTP_USE_TLS=true
#   EMAIL_FROM=you@gmail.com
#
# ▶ Brevo / Sendinblue (free 300/day, any recipient):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=<brevo-login-email>
#   SMTP_PASSWORD=<brevo-smtp-key>
#   SMTP_USE_TLS=true
#
# ▶ Outlook / Hotmail (free):
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_TLS=true
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_NAME=GWR Records

# Sender address shown in the From: header (falls back to SMTP_USERNAME).
EMAIL_FROM=noreply@glimmora.com

# Legacy SendGrid path — only used if SMTP_HOST is blank.
SENDGRID_API_KEY=

# ── Twilio ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Magic link ───────────────────────────────────────────────────────
MAGIC_LINK_EXPIRE_HOURS=72
FRONTEND_URL=http://localhost:5173
